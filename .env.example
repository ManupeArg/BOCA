# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pegá-acá-la-service-role-key

# Cualquier texto largo y secreto (por ej. generalo con: openssl rand -hex 32)
SESSION_SECRET=cambiame-por-un-texto-largo-y-secreto

# Opcional: mails que pueden registrarse, separados por coma.
# Si lo dejás vacío, cualquiera que tenga el link puede registrarse.
ALLOWED_EMAILS=
